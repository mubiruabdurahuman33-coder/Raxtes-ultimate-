def fetch_anime(q=""):
    query = 'query ($search: String) { Page(perPage: 30) { media(search: $search, type: ANIME, sort: POPULARITY_DESC) { id title { romaji } coverImage { large } format seasonYear } } }'
    try:
        r = requests.post(ANILIST_URL, json={"query": query, "variables": {"search": q if q else None}}, timeout=10)
        return [{"id": m["id"], "title": m["title"]["romaji"], "cover": m["coverImage"]["large"], "format": m["format"], "year": m["seasonYear"] or ""} for m in r.json()["data"]["Page"]["media"]]
    except: return []

def fetch_detail(aid):
    query = 'query ($id: Int) { Media(id: $id) { title { romaji } description coverImage { extraLarge } status seasonYear } }'
    try:
        r = requests.post(ANILIST_URL, json={"query": query, "variables": {"id": int(aid)}}, timeout=10)
        m = r.json()["data"]["Media"]
        return {"title": m["title"]["romaji"], "desc": (m["description"] or "")[:400], "cover": m["coverImage"]["extraLarge"], "status": m["status"], "year": m["seasonYear"] or ""}
    except: return None

def fetch_movies(q):
    try:
        s = VideosSearch(f"{q} full movie free HD", limit=30)
        return [{"id": v['id'], "title": v['title'], "cover": v['thumbnails'][0]['url'] if v['thumbnails'] else "", "format": "MOVIE", "year": v['duration']} for v in s.result()['result']]
    except: return []

@app.route("/")
def home():
    q=request.args.get("q","").strip(); tab=request.args.get("tab","home")
    animes=fetch_movies(q) if tab=="movies" and q else fetch_anime(q)
    return render_template_string(BASE_HTML, animes=animes, detail=None, q=q, tab=tab)

@app.route("/anime/<aid>")
def detail_page(aid):
    q=request.args.get("q",""); tab=request.args.get("tab","anime")
    d=fetch_detail(aid)
    return render_template_string(BASE_HTML, animes=[], detail=d, q=q, tab=tab)

def find_port():
    with socket.socket() as s: s.bind(("127.0.0.1",0)); return s.getsockname()[1]
def start(p): app.run(host="127.0.0.1", port=p, debug=False, use_reloader=False)

if __name__=="__main__":
    p=find_port(); threading.Thread(target=start, args=(p,), daemon=True).start()
    url=f"http://127.0.0.1:{p}"
    for _ in range(100):
        try: requests.get(url, timeout=0.25); break
        except: time.sleep(0.1)
    webview.create_window("RAXTES - MovieBox Clone", url, width=400, height=800)
    webview.start()
